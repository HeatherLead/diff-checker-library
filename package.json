{
  "name": "@ayushvc/diff-checker",
  "version": "1.1.3",
  "description": "Configurable Diff Checker component library with live API integration and dynamic sub-routing",
  "type": "module",
  "main": "./dist/diff-checker.cjs.js",
  "module": "./dist/diff-checker.es.js",
  "types": "./src/index.d.ts",
  "style": "./dist/style.css",
  "repository": {
    "type": "git",
    "url": "https://devops.vcgdigital.net/VectorDigitalLabs/TMS-WCMS/_git/diff-checker-library"
  },
  "exports": {
    ".": {
      "import": "./dist/diff-checker.es.js",
      "require": "./dist/diff-checker.cjs.js",
      "types": "./src/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./*": "./*"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=16.8.0 || ^18.0.0 || ^19.0.0",
    "react-dom": ">=16.8.0 || ^18.0.0 || ^19.0.0",
    "react-router-dom": ">=6.0.0",
    "ag-grid-community": "32.3.3",
    "ag-grid-enterprise": "32.3.3",
    "ag-grid-react": "32.3.3"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "lucide-react": "^1.31.0",
    "match-sorter": "^8.3.0",
    "react-diff-viewer-continued": "^4.4.0",
    "react-toastify": "^11.1.0",
    "use-sync-external-store": "^1.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "sass": "^1.80.0",
    "typescript": "^5.6.3",
    "vite": "^4.5.5"
  }
}